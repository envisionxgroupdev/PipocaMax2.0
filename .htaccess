# Pipoca Max
Options -Indexes
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bloqueia arquivos internos e ocultos (.git, .env etc.)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^install/database\.sql$ - [F,L]
  RewriteRule ^(config\.php|LEIA-ME\.md)$ - [F,L]

  # Para forçar HTTPS, tire o # das duas linhas abaixo (só depois que o SSL estiver ativo)
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # URLs amigáveis
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(filme|serie|anime)/([0-9]+)(-[^/]*)?/?$ titulo.php?id=$2 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^canal/([0-9]+)(-[^/]*)?/?$ canal.php?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(filmes|series|animes|lancamentos|tv|busca|login|cadastro|conta|minha-lista)/?$ $1.php [L,QSA]
</IfModule>

<FilesMatch "^(config\.php|database\.sql|LEIA-ME\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>
